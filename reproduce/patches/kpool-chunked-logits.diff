+    @staticmethod
+    def _kpool_logits_rows_per_chunk(
+        n_rows: int, n_cols: int, device: torch.device
+    ) -> int:
+        if n_rows * n_cols < 8_000_000 or get_is_capture_mode():
+            return n_rows
+        bytes_per_row = n_cols * 4
+        cap = int(os.environ.get("SGLANG_DSA_KPOOL_LOGITS_BUDGET_MB", "4096")) << 20
+        free_mem, total_mem = torch.cuda.mem_get_info(device)
+        cached_free = torch.cuda.memory_reserved(device) - torch.cuda.memory_allocated(
+            device
+        )
+        budget = min(cap, (free_mem + cached_free) // 2, int(total_mem * 0.3))
+        return max(1, min(n_rows, budget // bytes_per_row))
+
+    def _topk_from_kpool_logits_chunked(
+        self,
+        q_fp8: torch.Tensor,
+        weights: torch.Tensor,
+        kv_fp8: Tuple[torch.Tensor, torch.Tensor],
+        n_real: int,
+        rows_per_chunk: int,
+        pool_lens: torch.Tensor,
+        seq_lens: Optional[torch.Tensor],
+        page_table: Optional[torch.Tensor],
+        topk_offsets: Optional[torch.Tensor],
+        row_starts: torch.Tensor,
+        row_ends: torch.Tensor,
+        out_rows: int,
+        page_table_row_index: Optional[torch.Tensor],
+    ) -> torch.Tensor:
+        results = []
+        for start in range(0, n_real, rows_per_chunk):
+            end = min(start + rows_per_chunk, n_real)
+            logits_chunk = deep_gemm.fp8_mqa_logits(
+                q_fp8[start:end].contiguous(),
+                kv_fp8,
+                weights[start:end].contiguous(),
+                row_starts[start:end].contiguous(),
+                row_ends[start:end].contiguous(),
+                clean_logits=True,
+            )
+            chunk_page_table = page_table
+            chunk_row_index = None
+            if page_table is not None:
+                if page_table_row_index is not None:
+                    chunk_row_index = page_table_row_index[start:end]
+                else:
+                    chunk_page_table = page_table[start:end]
+            results.append(
+                self._topk_from_kpool_logits(
+                    logits_chunk,
+                    pool_lens[start:end],
+                    seq_lens=None if seq_lens is None else seq_lens[start:end],
+                    page_table=chunk_page_table,
+                    topk_offsets=(
+                        None if topk_offsets is None else topk_offsets[start:end]
+                    ),
+                    row_starts=row_starts[start:end],
+                    out_rows=None,
+                    page_table_row_index=chunk_row_index,
+                )
+            )
+            del logits_chunk
+        result = torch.cat(results, dim=0)
+        if out_rows == result.shape[0]:
+            return result
+        padded = torch.full(
+            (out_rows, result.shape[1]), -1, dtype=result.dtype, device=result.device
+        )
+        padded[: result.shape[0]] = result
+        return padded
+
